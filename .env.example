# Copy to .env.local for `vercel dev` (git-ignored), and set the same names in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# Web app URL of the Google Apps Script (Deploy > Manage deployments > Web app URL, ends in /exec)
APPS_SCRIPT_URL=
# Any long random string. Put the SAME value in the Apps Script's Script properties as LEAD_SECRET.
LEAD_SECRET=

# Cloudflare Turnstile widget for international.cognasiumindia.com
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# "true" lets students who confirm they are 18 or older submit. Empty or "false" = parents only.
ALLOW_ADULT_STUDENTS=
