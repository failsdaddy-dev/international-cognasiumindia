# Copy to .env.local for `vercel dev` (git-ignored), and set the same names in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# Resend (https://resend.com): API key with "Sending access"
RESEND_API_KEY=
# Who receives the leads (comma-separate for more than one)
LEAD_TO_EMAIL=
# Sender on the domain verified in Resend, e.g. Cognasium Enquiries <leads@cognasiumindia.com>
LEAD_FROM_EMAIL=

# Cloudflare Turnstile widget for international.cognasiumindia.com
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Any long random string (signs the form's start time)
FORM_SECRET=

# "true" lets students who confirm they are 18 or older submit. Empty or "false" = parents only.
ALLOW_ADULT_STUDENTS=

# Optional: Upstash Redis for rate limits and duplicate checks (filled in automatically
# when you add Upstash from Vercel > Storage). Without them, limits only last per server instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
